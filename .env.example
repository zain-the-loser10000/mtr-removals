# Copy to .env for local development.
# On Vercel, add each of these under Project > Settings > Environment Variables.

# ---- Email (Gmail) ----
# 1. Turn on 2-Step Verification on the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mtrremovals.au@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_TO=mtrremovals.au@gmail.com
MAIL_FROM_NAME=MTR Removals Website
SEND_AUTO_REPLY=true

# ---- Database (Postgres) ----
# Vercel: Storage > Create > Neon (Postgres). It adds DATABASE_URL for you.
# Or paste a Supabase / Neon connection string here.
DATABASE_URL=

# ---- Admin ----
# Secret to view leads: GET /api/enquiries with header  Authorization: Bearer <token>
ADMIN_TOKEN=change-this-to-a-long-random-string

# ---- Frontend (optional) ----
# Only set this if the API is on a different domain than the website.
VITE_API_URL=
